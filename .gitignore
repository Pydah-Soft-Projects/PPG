# Root gitignore for Pydah Payment Gateway

# Dependency folders
node_modules/
*/node_modules/

# Environment and sensitive keys
.env
.env.local
.env.*.local
*/.env
*/.env.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
dist/
build/
*/dist/

# Operating system & Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

