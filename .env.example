# Environment Configuration Example
# Replace placeholders with secure values in your actual .env file.
# Never commit real credentials to source control.

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pydah_payment_gateway

# Symmetrical 256-bit encryption key (32 bytes as 64-character hex string)
# Used for encrypting provider secrets (Razorpay Key Secret, Webhook Secret) at rest
PROVIDER_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Pepper for application secret hashing (min 32 characters)
APP_CREDENTIAL_PEPPER=sample_pepper_for_application_secret_hashing_min32chars

# JWT secret for admin dashboard sessions (min 32 characters)
ADMIN_SESSION_SECRET=sample_jwt_secret_for_admin_sessions_min32chars

# Allowed CORS origin for admin dashboard
DASHBOARD_ORIGIN=http://localhost:3000

# Outbound notification timeout in milliseconds
NOTIFICATION_TIMEOUT_MS=5000

