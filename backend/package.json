{
  "name": "pydah-payment-gateway-backend",
  "version": "1.0.0",
  "description": "Centralized payment orchestration service for PydahSoft applications",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/database/seed.js",
    "test:client": "node scripts/test-client.js",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "keywords": [
    "payment",
    "gateway",
    "razorpay",
    "orchestration",
    "pydahsoft"
  ],
  "author": "PydahSoft",
  "license": "UNLICENSED",
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "mysql2": "^3.12.0",
    "razorpay": "^2.9.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  }
}
