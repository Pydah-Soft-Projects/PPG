# Pydah Payment Gateway - Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration (Dedicated database)
MONGODB_URI=mongodb://127.0.0.1:27017/pydah_payment_gateway

# Cryptographic Keys (Hex encoded 32-byte / 256-bit strings)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROVIDER_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
APP_CREDENTIAL_PEPPER=pydah_pepper_secret_dev_key_2026

# Admin JWT Authentication
ADMIN_JWT_SECRET=super_secure_admin_jwt_secret_dev_only_change_in_prod
ADMIN_JWT_EXPIRES_IN=7d

# Outbound Notification Signing
NOTIFICATION_SIGNING_SECRET=pydah_outbound_webhook_secret_key_2026

# Dashboard / CORS Allowed Origins
DASHBOARD_ORIGIN=http://localhost:5173,http://localhost:3000

# External MySQL Student Database (Colleges & Courses)
DB_HOST=student-database.cfu0qmo26gh3.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=
DB_NAME=student_database
DB_SSL=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

